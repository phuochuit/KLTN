<Window x:Class="LumiPark.Desktop.PaymentPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xác nhận thu phí" Width="500" MinWidth="420" MaxWidth="620" SizeToContent="Height" MinHeight="420" FontFamily="{StaticResource AppFont}" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}" ShowInTaskbar="False" KeyboardNavigation.TabNavigation="Cycle">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Margin="18" Padding="24" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20"><StackPanel>
  <TextBlock Text="Xác nhận phí xe ra" FontSize="23" FontWeight="Bold"/><TextBlock Text="Kiểm tra khoản thu và phương thức trước khi xác nhận." Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>
  <Border Background="#F3F5FF" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="PHÍ XEM TRƯỚC" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FeeText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Primary}" Margin="0,4,0,0"/></StackPanel></Border>
  <Label Content="Phương thức thanh toán" Target="{Binding ElementName=MethodPicker}" Margin="0,13,0,3" FontWeight="SemiBold"/><ComboBox x:Name="MethodPicker" AutomationProperties.Name="Phương thức thanh toán" MinHeight="44" SelectedIndex="0"><ComboBoxItem Content="Tiền mặt" Tag="CASH"/><ComboBoxItem Content="Chuyển khoản" Tag="BANK_TRANSFER"/><ComboBoxItem Content="Thẻ qua POS" Tag="POS"/></ComboBox>
  <StackPanel x:Name="ReferencePanel"><Label Content="Mã tham chiếu (bắt buộc)" Target="{Binding ElementName=ReferenceBox}" Margin="0,10,0,2" FontWeight="SemiBold"/><TextBox x:Name="ReferenceBox" AutomationProperties.Name="Mã tham chiếu thanh toán"/></StackPanel>
  <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Hủy" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="ConfirmButton" Content="Xác nhận thu và xe ra" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/></StackPanel>
 </StackPanel></Border></ScrollViewer>
</Window>
