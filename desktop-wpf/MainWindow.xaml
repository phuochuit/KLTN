<Window x:Class="LumiPark.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LumiPark · Trạm gác" Width="1440" Height="940" MinWidth="900" MinHeight="580" FontFamily="{StaticResource AppFont}" Background="{StaticResource Canvas}" UseLayoutRounding="True" Closing="OnClosing" Closed="OnClosed">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVis"/></Window.Resources>
 <Grid>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E6F1FF"/><GradientStop Color="#F6F7FF" Offset=".52"/><GradientStop Color="#EEE9FF" Offset="1"/></LinearGradientBrush></Grid.Background>
  <DockPanel>
   <Border x:Name="DemoBanner" DockPanel.Dock="Top" Background="#FFFFF7E6" Padding="14,8" Visibility="Collapsed"><TextBlock Text="CHẾ ĐỘ TRÌNH DIỄN · DỮ LIỆU MINH HỌA · KHÔNG KẾT NỐI HỆ THỐNG THẬT" FontWeight="SemiBold" Foreground="#72500E" HorizontalAlignment="Center"/></Border>
   <Grid>
    <Border Visibility="{Binding LoginVisible, Converter={StaticResource BoolVis}}" Width="500" Padding="42" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F9FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="28">
     <Border.Effect><DropShadowEffect Color="#46558B" Opacity=".14" BlurRadius="30" ShadowDepth="10"/></Border.Effect>
     <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,30"><Image Source="{StaticResource LumiParkLogo}" Width="52" Height="52" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="LumiPark" FontSize="22" FontWeight="Bold"/><TextBlock Text="SMART PARKING OPERATIONS" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
      <TextBlock Text="Chào mừng trở lại" FontSize="28" FontWeight="Bold"/><TextBlock Text="Đăng nhập để tiếp tục phiên làm việc tại trạm." Foreground="{StaticResource Muted}" Margin="0,8,0,22"/>
      <Label Content="Tên đăng nhập" Target="{Binding ElementName=UsernameBox}" Padding="0,0,0,7" FontWeight="SemiBold"/><TextBox x:Name="UsernameBox" AutomationProperties.Name="Tên đăng nhập" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCredentials}" Margin="0,0,0,14"/>
      <Label Content="Mật khẩu" Target="{Binding ElementName=PasswordInput}" Padding="0,0,0,7" FontWeight="SemiBold"/><PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Mật khẩu" IsEnabled="{Binding CanEditCredentials}" Margin="0,0,0,14"/>
      <Expander Header="Địa chỉ kết nối" Margin="0,0,0,14"><StackPanel><Label Content="Địa chỉ máy chủ" Target="{Binding ElementName=UrlBox}"/><TextBox x:Name="UrlBox" AutomationProperties.Name="Địa chỉ máy chủ" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCredentials}" IsReadOnly="{Binding IsDemo, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></Expander>
      <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/><Button x:Name="LoginButton" Content="Đăng nhập" IsDefault="{Binding LoginVisible}" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
     </StackPanel>
    </Border>
    <DockPanel Visibility="{Binding WorkspaceVisible, Converter={StaticResource BoolVis}}">
     <Border DockPanel.Dock="Top" Background="#F5FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="0,0,0,1" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Image Source="{StaticResource LumiParkLogo}" Width="38" Height="38" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="LumiPark" FontWeight="Bold" FontSize="18"/><TextBlock Text="TRẠM GÁC" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0"><TextBlock Text="{Binding OperatorName}" FontWeight="SemiBold" Margin="0,0,18,0"/><TextBlock Text="{Binding ShiftText}" Foreground="{StaticResource Muted}" Margin="0,0,18,0"/><TextBlock Text="{Binding Connection}" Foreground="{StaticResource Good}" FontWeight="SemiBold"/></StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="DemoToolsButton" Content="Công cụ demo" Click="DemoTools_Click" Visibility="Collapsed" Margin="0,0,8,0"/><Button Content="Sơ đồ bãi xe" Click="ParkingMap_Click" Margin="0,0,8,0"/><Button Content="Tình trạng dịch vụ" Click="Health_Click" Margin="0,0,8,0"/><Button x:Name="LogoutButton" Content="Đăng xuất" Click="Logout_Click"/></StackPanel></Grid></Border>
        <Grid x:Name="WorkspaceHost" Margin="20,14,20,18" SizeChanged="WorkspaceHost_SizeChanged">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid x:Name="WorkspaceTitlePanel" Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Xử lý phương tiện" FontSize="24" FontWeight="Bold"/><TextBlock Text="Tiếp nhận xe, xác minh thông tin và hoàn tất giao dịch." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Nhân viên trực" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBlock Text="{Binding OperatorName}" FontWeight="SemiBold"/></StackPanel></Grid>
        <ScrollViewer Grid.Row="1" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><Button x:Name="CorrectionButton" Content="Hiệu chỉnh" Click="Correction_Click" Margin="0,0,6,0"/><Button x:Name="EvidenceButton" Content="Đối chiếu ảnh" Click="Evidence_Click" Margin="0,0,6,0"/><Button Content="Cài đặt trạm" Click="Settings_Click" Margin="0,0,6,0"/><Button x:Name="CurrentSummaryButton" Content="Tổng kết ca hiện tại" Click="CurrentSummary_Click" Margin="0,0,6,0"/><TextBlock x:Name="BarrierStatusText" Text="MÔ PHỎNG · ĐANG ĐÓNG" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,6,0"/><Button x:Name="BarrierOpenButton" Content="Mở mô phỏng" Click="BarrierOpen_Click" Margin="0,0,6,0"/><Button x:Name="BarrierCloseButton" Content="Đóng mô phỏng" Click="BarrierClose_Click"/></StackPanel></ScrollViewer>
       <Grid x:Name="Ops" Grid.Row="2" DataContext="{x:Null}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F9FFFFFF" BorderBrush="#DCE3F2" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal"><Button x:Name="EntryModeButton" Content="XE VÀO" Style="{StaticResource EntryMode}" Click="EntryMode_Click" Margin="0,0,8,0"/><Button x:Name="ExitModeButton" Content="XE RA" Style="{StaticResource ExitMode}" Click="ExitMode_Click"/><TextBlock x:Name="VehicleTypeText" Text="Loại xe · Chưa nhận dạng" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource Muted}"/><StackPanel x:Name="CompactMediaActions" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0"><Button Content="Camera xe" Click="VehicleCamera_Click" Margin="0,0,6,0"/><Button x:Name="CompactSourcesButton" Content="Nguồn khác" Click="CompactSources_Click" Margin="0"><Button.ContextMenu><ContextMenu><MenuItem Header="Ảnh/video xe…" Click="VehicleFile_Click"/><MenuItem Header="Ảnh xe + khuôn mặt…" Click="CombinedFile_Click"/><Separator/><MenuItem Header="Camera khuôn mặt" Click="FaceCamera_Click"/><MenuItem Header="Tệp khuôn mặt…" Click="FaceFile_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel></StackPanel>
          <ScrollViewer x:Name="MediaScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="MediaScroll_SizeChanged"><Grid x:Name="MediaScrollContent" MinHeight="0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="VehicleImageViewport" Background="#E9EDF7" CornerRadius="14" MinHeight="190"><Image x:Name="VehicleImage" Stretch="Uniform"/></Border><Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Padding="7,4" CornerRadius="8" Background="#DDFFFFFF"><TextBlock Text="ẢNH XE · BẰNG CHỨNG" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></Border><DockPanel Grid.Row="1" Margin="0,10,0,0"><Border Width="88" Height="66" Background="#E9EDF7" CornerRadius="10" Margin="0,0,10,0"><Image x:Name="FaceImage" Stretch="UniformToFill"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Ảnh khuôn mặt" FontWeight="SemiBold"/><TextBlock x:Name="FaceState" Text="Chưa ghi nhận" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel><StackPanel Grid.Row="2" Margin="0,10,0,0"><WrapPanel x:Name="MediaActions"><Button Content="Camera xe" Click="VehicleCamera_Click" Margin="0,0,7,7"/><Button Content="Ảnh/video xe…" Click="VehicleFile_Click" Margin="0,0,7,7"/><Button Content="Ảnh + khuôn mặt…" Click="CombinedFile_Click" Margin="0,0,7,7"/><Button Content="Camera khuôn mặt" Click="FaceCamera_Click" Margin="0,0,7,7"/><Button x:Name="FaceFileButton" Content="Tệp khuôn mặt…" Click="FaceFile_Click" Margin="0,0,7,7" Visibility="Collapsed"/></WrapPanel><TextBlock x:Name="FaceFileReason" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel></Grid></ScrollViewer>
       </Grid></Border>
       <Border Grid.Column="1" Background="#F9FFFFFF" BorderBrush="#DCE3F2" BorderThickness="1" CornerRadius="18" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="1" Margin="0,4,0,10"><TextBlock Text="Biển số" FontWeight="SemiBold"/><DockPanel Margin="0,5,0,0"><Button x:Name="LookupButton" Content="Tra cứu" Click="Lookup_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="PlateBox" FontSize="24" FontWeight="Bold" TextChanged="Plate_TextChanged" AutomationProperties.Name="Biển số xe"/></DockPanel><TextBlock x:Name="LookupStatus" Text="Chưa tra cứu" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="OperationStatus" Text="Sẵn sàng" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="PreviewFeeText" Foreground="{StaticResource Primary}" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Thành viên được phép" FontWeight="SemiBold"/><ComboBox x:Name="MemberPicker" AutomationProperties.Name="Thành viên được phép" SelectionChanged="Member_SelectionChanged" Margin="0,6,0,12"/>
        <Border Background="#F3F5FF" BorderBrush="#DCE3F2" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock x:Name="OwnerText" Text="Chưa có thông tin tra cứu"/><TextBlock x:Name="PackageText" Text="" Margin="0,6,0,0"/><TextBlock x:Name="PackageWarning" Foreground="{StaticResource Danger}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
        <TextBlock x:Name="ReceiptText" Foreground="{StaticResource Good}" Margin="0,5,0,0" TextWrapping="Wrap"/>
       </StackPanel></ScrollViewer><TextBlock x:Name="BusyText" Grid.Row="3" Text="Đang xử lý…" Foreground="{StaticResource Primary}" Margin="0,8,0,0" Visibility="Collapsed"/></Grid></Border>
      </Grid>
       <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="HoldIcon" Height="24" Width="24" CornerRadius="12" Background="#FCE8E6" Visibility="Collapsed" Margin="0,0,8,0"><TextBlock Text="!" FontWeight="Bold" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="HoldText" Text="" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="620"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="NextButton" Content="Lượt tiếp theo" Click="Next_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="MainAction" Content="Xác nhận xe vào" Style="{StaticResource PrimaryButton}" Click="MainAction_Click" MinWidth="220"/></StackPanel></Grid>
     </Grid>
    </DockPanel>
   </Grid>
  </DockPanel>
 </Grid>
</Window>
