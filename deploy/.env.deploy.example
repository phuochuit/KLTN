# ============================================================
# Cau hinh deploy cho Docker Compose
# Sao chep file nay thanh .env.deploy roi dien gia tri thuc.
# Khong commit .env.deploy len git.
# ============================================================

# Che do chon database: auto | aiven | laragon
# - auto: thu Aiven truoc, that bai thi chuyen Laragon
# - aiven: chi dung Aiven
# - laragon: chi dung Laragon (may Windows dang chay Laragon)
PARKING_DB_MODE=auto

# ------------------------- AIVEN ----------------------------
PARKING_AIVEN_URL=jdbc:mysql://YOUR_AIVEN_HOST:PORT/defaultdb?sslMode=REQUIRED&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
PARKING_AIVEN_HOST=YOUR_AIVEN_HOST
PARKING_AIVEN_PORT=PORT
PARKING_AIVEN_DB=defaultdb
PARKING_AIVEN_USERNAME=avnadmin
PARKING_AIVEN_PASSWORD=YOUR_AIVEN_PASSWORD

# ------------------------ LARAGON ---------------------------
PARKING_LARAGON_URL=jdbc:mysql://host.docker.internal:3306/parking_anpr?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
PARKING_LARAGON_HOST=host.docker.internal
PARKING_LARAGON_PORT=3306
PARKING_LARAGON_DB=parking_anpr
PARKING_LARAGON_USERNAME=parking
PARKING_LARAGON_PASSWORD=YOUR_LARAGON_PASSWORD

# --------------------------- JWT ----------------------------
# Phai khop URL public. Neu doi domain thi token cu mat hieu luc.
PARKING_SECURITY_JWT_ISSUER=https://lumipark.tail57e32c.ts.net
PARKING_SECURITY_JWT_AUDIENCE=parking-desktop
PARKING_SECURITY_JWT_KID=key-2026-11
PARKING_SECURITY_JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt-private.pem
PARKING_SECURITY_JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt-public.pem

# ------------------------- STORAGE --------------------------
PARKING_PRIVATE_STORAGE_PATH=/data/private
PARKING_UPLOAD_DIR=/data/private/uploads

# ------------------------- SECURITY -------------------------
# Token noi bo giua Spring va ANPR; dat chuoi dai ngau nhien.
PARKING_INTERNAL_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
# Mat khau admin tao lan dau; bat buoc doi khi dang nhap.
PARKING_DEMO_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
