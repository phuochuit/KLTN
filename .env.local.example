# Aiven MySQL primary database. Copy this file to .env.local and fill secrets.
PARKING_DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/parking_anpr?sslMode=REQUIRED&allowPublicKeyRetrieval=TRUE
PARKING_DB_USERNAME=YOUR_AIVEN_USERNAME
PARKING_DB_PASSWORD=YOUR_AIVEN_PASSWORD

# Optional override. Local launchers generate an ignored 256-bit token when omitted.
PARKING_INTERNAL_SERVICE_TOKEN=GENERATE_A_RANDOM_256_BIT_TOKEN
# PARKING_INTERNAL_PREVIOUS_TOKEN=PREVIOUS_TOKEN_DURING_ROTATION_ONLY

# Production may use two independent cameras. Laptop demo can leave both at 0.
PARKING_VEHICLE_CAMERA_INDEX=0
PARKING_FACE_CAMERA_INDEX=0
